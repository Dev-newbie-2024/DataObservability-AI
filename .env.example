# ════════════════════════════════════════════════════════════════════════════
# DataObservability-AI — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ════════════════════════════════════════════════════════════════════════════

# ─── Application ─────────────────────────────────────────────────────────────
APP_ENV=development                         # development | staging | production
APP_NAME=DataObservability-AI
APP_VERSION=0.1.0
LOG_LEVEL=INFO                              # DEBUG | INFO | WARNING | ERROR

# ─── FastAPI Backend ─────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=true                         # Set false in production
BACKEND_WORKERS=1                           # Increase in production

# ─── Streamlit Dashboard ─────────────────────────────────────────────────────
DASHBOARD_PORT=8501
BACKEND_URL=http://backend:8000             # Internal Docker network URL

# ─── Snowflake ───────────────────────────────────────────────────────────────
SNOWFLAKE_ACCOUNT=your_account_identifier   # e.g. xy12345.us-east-1
SNOWFLAKE_USER=your_snowflake_user
SNOWFLAKE_PASSWORD=your_snowflake_password
SNOWFLAKE_DATABASE=OBSERVABILITY_DB
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_ROLE=SYSADMIN
SNOWFLAKE_SCHEMA=OBSERVABILITY             # Default control schema

# ─── Kafka ───────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9092          # Internal Docker network
KAFKA_EXTERNAL_BOOTSTRAP_SERVERS=localhost:9093  # From host machine
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_GROUP_ID_PREFIX=observability-

# ─── Airflow ─────────────────────────────────────────────────────────────────
AIRFLOW_UID=50000
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__WEBSERVER__SECRET_KEY=change_me_in_production_use_openssl_rand_hex_32
AIRFLOW__API__AUTH_BACKENDS=airflow.api.auth.backend.basic_auth
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin

# ─── Great Expectations ──────────────────────────────────────────────────────
GX_ROOT_DIR=config/great_expectations

# ─── Evidently AI ────────────────────────────────────────────────────────────
EVIDENTLY_REPORTS_DIR=/tmp/evidently_reports

# ─── dbt ─────────────────────────────────────────────────────────────────────
DBT_PROFILES_DIR=config
DBT_PROJECT_DIR=dbt
DBT_TARGET=dev                              # dev | staging | prod

# ─── Alerting / Notifications ────────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
ALERT_EMAIL_FROM=alerts@yourdomain.com
ALERT_EMAIL_TO=team@yourdomain.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# ─── Cost Monitoring ─────────────────────────────────────────────────────────
SNOWFLAKE_CREDIT_PRICE_USD=3.00            # Price per Snowflake credit in USD
COST_BUDGET_DAILY_CREDITS=10.0             # Daily credit budget
COST_BUDGET_MONTHLY_CREDITS=250.0          # Monthly credit budget
COST_ALERT_THRESHOLD_PCT=80               # Alert at 80% of budget consumed

# ─── Data Quality Thresholds ─────────────────────────────────────────────────
DQ_NULL_RATE_THRESHOLD=0.05               # Max allowed null rate (5%)
DQ_DUPLICATE_RATE_THRESHOLD=0.02          # Max allowed duplicate rate (2%)
DQ_TYPE_MISMATCH_THRESHOLD=0.01           # Max allowed type mismatch (1%)
DQ_MIN_QUALITY_SCORE=80.0                 # Min acceptable composite DQ score

# ─── Drift Detection ─────────────────────────────────────────────────────────
DRIFT_KS_PVALUE_THRESHOLD=0.05            # KS-test p-value threshold
DRIFT_PSI_THRESHOLD=0.2                   # PSI score threshold (>0.2 = significant)
DRIFT_REFERENCE_WINDOW_DAYS=30            # Days of data used as reference

# ─── Agent Settings ──────────────────────────────────────────────────────────
AGENT_MAX_RETRIES=3                        # Max retries before escalation
AGENT_RETRY_DELAY_SECONDS=60              # Delay between retries
HEALING_QUARANTINE_SCHEMA=QUARANTINE       # Snowflake schema for bad data
